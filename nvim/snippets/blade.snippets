# Blade templates

snippet bx <x-component>
	<x-${1:component} ${2}>
		$0
	</x-$1>

snippet bform form with @csrf
	<form method="POST" action="{{ route('${1:route.name}') }}">
		@csrf
		$0
	</form>

snippet berror @error block
	@error('${1:field}')
		<p class="${2:text-sm text-red-600}">{{ \$message }}</p>
	@enderror

snippet bold old() value
	value="{{ old('${1:field}') }}"
