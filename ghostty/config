theme = catppuccin-mocha.conf
# background = #1a1c1c
background = #181818
font-family = "GeistMono Nerd Font"
cursor-style = block
adjust-cell-height = 35%

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

window-padding-balance = true

macos-titlebar-style = transparent

# this setting is currently only supported on macOs
window-colorspace = "display-p3"
window-save-state = always

# Keybindings: mirrors my Neovim mappings, using alt instead of the <leader> and ctrl key.
keybind = alt+r=reload_config
keybind = alt+shift+v=new_split:right
keybind = alt+shift+h=new_split:down
keybind = alt+x>s=close_surface
keybind = alt+s>e=equalize_splits
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+s>z=toggle_split_zoom

gtk-titlebar = true

bell-features = no-system,no-audio
bell-audio-volume = 0.0
app-notifications = clipboard-copy
